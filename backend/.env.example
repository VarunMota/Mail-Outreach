# App Config
PROJECT_NAME="Cold Email Outreach API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Config
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=email_outreach
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_outreach

# Redis Config
REDIS_HOST=localhost
REDIS_PORT=6379

# Celery Config
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email Config (Jinja2)
EMAIL_TEMPLATES_DIR=app/services/email/templates

# SMTP Config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_NAME=Outreach Team
BASE_URL=http://localhost:8000

# IMAP Config (checking replies)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password

# Google OAuth Config
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.send

# JWT Config
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION_HOURS=24

# Encryption Key (for tokens and passwords)
ENCRYPTION_KEY=your-encryption-key-32-chars-long


